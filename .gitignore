# 构建产物
deploy/out/
# Docker 构建上下文里的二进制（由 build.ps1 自动复制，不入库）
deploy/docker/svrmon-hub-linux-amd64

# 前端
web/node_modules/
web/dist/

# 运行数据
*.db
*.db-shm
*.db-wal
run/
*.exe~

# 嵌入的前端产物：只跟踪 .gitkeep（保证 go:embed 目录存在），
# index.html 与 assets/ 都是构建产物，由 deploy/build.ps1 生成，不入库
cmd/hub/assets/dist/*
!cmd/hub/assets/dist/.gitkeep
